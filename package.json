{
  "name": "multicte-outbound-api",
  "version": "1.0.0",
  "description": "API de integrações do MultiEmbarcador com o Grupo Boticário",
  "author": "Grupo Boticário",
  "private": true,
  "license": "private",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --forceExit --detectOpenHandles --config ./test/jest-e2e.json",
    "doc": "npx @compodoc/compodoc -p tsconfig.json",
    "doc:serve": "npm run doc && npx @compodoc/compodoc -s",
    "sonar-scanner": "node node_modules/sonarqube-scanner/dist/bin/sonar-scanner",
    "prettier:write": "prettier --write ./**/*.{ts,js,json}",
    "precommit": "lint-staged && npm run lint",
    "prepush": "npm run test",
    "prepare": "is-ci || husky install",
    "commit": "cz"
  },
  "dependencies": {
    "@fastify/compress": "^5.0.0",
    "@fastify/helmet": "^8.0.1",
    "@fastify/request-context": "^3.0.0",
    "@nestjs/axios": "3.0.1",
    "@nestjs/common": "^8.4.4",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^8.4.4",
    "@nestjs/platform-fastify": "^8.4.4",
    "@nestjs/swagger": "^5.2.1",
    "@nestjs/terminus": "^8.0.6",
    "@newrelic/winston-enricher": "^4.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cli-color": "^2.0.2",
    "date-fns": "^2.28.0",
    "fastify": "^3.28.0",
    "fastify-swagger": "^5.2.0",
    "lodash": "^4.17.21",
    "nestjs-sap-rfc": "^1.4.0",
    "newrelic": "^9.7.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.1",
    "winston": "^3.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@compodoc/compodoc": "^1.1.19",
    "@nestjs/cli": "^9.4.2",
    "@nestjs/schematics": "^8.0.11",
    "@nestjs/testing": "^8.4.4",
    "@types/cli-color": "^2.0.2",
    "@types/jest": "^27.5.1",
    "@types/lodash": "^4.14.202",
    "@types/newrelic": "^7.0.3",
    "@types/node": "^20.5.9",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.62.0",
    "commitizen": "^4.2.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^8.0.1",
    "is-ci": "^3.0.1",
    "jest": "^27.5.1",
    "lint-staged": "^15.2.1",
    "prettier": "^2.6.2",
    "sonarqube-scanner": "^2.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.2.3",
    "ts-jest": "^27.1.5",
    "ts-loader": "^9.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^4.6.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "node"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
